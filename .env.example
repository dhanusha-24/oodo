# ==============================================================================
# Subscription Management System - Environment Configuration
# Reference: Tech Stack Document Section 11
# ==============================================================================

# Backend — server only; sample values are placeholders
APP_ENV=development
DATABASE_URL=postgresql+psycopg://app:CHANGE_ME@postgres:5432/subscriptions
REDIS_URL=redis://redis:6379/0
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET
FRONTEND_ORIGIN=http://localhost:5173
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_BUCKET=documents
OBJECT_STORAGE_ACCESS_KEY=CHANGE_ME
OBJECT_STORAGE_SECRET_KEY=CHANGE_ME
SMTP_HOST=mailpit
SMTP_PORT=1025
GEMINI_API_KEY=SET_SERVER_SIDE_ONLY
GEMINI_MODEL=SET_VERIFIED_FREE_TIER_FLASH_MODEL
AI_ENABLED=true
AI_MAX_REQUESTS_PER_USER_PER_DAY=20
AI_TIMEOUT_SECONDS=15

# PostgreSQL container settings
POSTGRES_USER=app
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=subscriptions

# MinIO container settings
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME

# Frontend — browser safe only
VITE_API_BASE_URL=http://localhost:8000/api/v1
